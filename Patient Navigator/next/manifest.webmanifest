{
  "name": "Jarurat Care Patient Navigator",
  "short_name": "Jarurat Care",
  "description": "Cancer care navigation for the Jarurat Care team.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "id": "jarurat-care-patient-navigator",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f5ede0",
  "theme_color": "#7b4b27",
  "categories": [
    "health",
    "medical",
    "productivity"
  ],
  "share_target": {
    "action": "./share-recording",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "recording",
          "accept": [
            "audio/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".ogg",
            ".opus"
          ]
        }
      ]
    }
  },
  "lang": "en-IN",
  "dir": "ltr",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
